---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import SiteNav from '../components/SiteNav.astro';
import SiteClosing from '../components/SiteClosing.astro';
import QuoteDialog from '../components/QuoteDialog.astro';
import d from '../data/home.json';
import map from '../data/map-peninsular.json';
import fleetData from '../data/fleet.json';
import sharp from 'sharp';

const fleetAll = fleetData.groups.flatMap((g) => g.items.map((v) => ({ ...v, group: g.label })));
const aboutParts = d.about.text.split(/(1996|2005)/);
let wIdx = 0;
const aboutWords = aboutParts.flatMap((t, i) => t.split(/(\s+)/).filter(Boolean).map((w) => (/^\s+$/.test(w) ? { sp: true } : { w, hl: i % 2 === 1, i: wIdx++ })));
const titleWords = d.about.title.split(' ');
let sIdx = 0;
const subTokens = d.hero.subtitle.split(/(\s+)/).filter(Boolean).map((t) => (/^\s+$/.test(t) ? { sp: t } : { w: t, i: sIdx++ }));
// Real image sizes, so every poster reserves its space before it loads (no empty or jumping carousel)
const posters = await Promise.all(d.record.posters.filter((p) => p.image).map(async (p) => {
  try { const m = await sharp('public' + p.image).metadata(); return { ...p, w: m.width, h: m.height }; } catch { return { ...p, w: 480, h: 640 }; }
}));
const hub = (id) => map.hubs.find((h) => h.id === id);
const hq = hub('hq');
const curve = (a, b, k = 0.2) => { const mx = (a.x + b.x) / 2, my = (a.y + b.y) / 2, dx = b.x - a.x, dy = b.y - a.y; return `M${a.x} ${a.y} Q${(mx - dy * k).toFixed(1)} ${(my + dx * k).toFixed(1)} ${b.x} ${b.y}`; };
const lab = { hq: [14, 5, 'start'], penang: [-11, 4, 'end'], alor: [-11, 4, 'end'], ipoh: [-11, 4, 'end'], kotabharu: [11, 4, 'start'], kuantan: [11, 4, 'start'], melaka: [11, 4, 'start'], jb: [-11, 4, 'end'] };
const marquee = [...d.marquee, ...d.marquee, ...d.marquee];
const allRegions = d.coverage.regionGroups.flatMap((g) => g.items);
const crossBorder = ['Singapore', 'Thailand'];
---

<Base title={`${d.site.name} | Lorry & Logistics Company, Petaling Jaya`} description="Kasi Transport is a Petaling Jaya logistics company for linehaul, commercial cargo and event transport across Peninsular Malaysia. Request a quote on WhatsApp.">
  <!-- HERO -->
  <SiteNav home />
  <div id="hero-wrap" class="relative">
  <section id="hero" class="sticky top-0 isolate flex h-screen flex-col overflow-hidden bg-[#050b1f] text-white">
    <div id="hero-parallax" class="hero-media absolute inset-x-0 top-0 -z-10 h-[74%] origin-bottom will-change-transform lg:inset-0 lg:h-auto" style="transform:scale(1.03)">
      <picture>
        {d.hero.imageMobile && <source media="(max-width: 1023px)" srcset={d.hero.imageMobile} />}
        <img src={d.hero.image} alt="Kasi Transport trucks at night" class="hero-bg h-full w-full object-cover object-[92%_40%] lg:object-[50%_80%]" fetchpriority="high" />
      </picture>
      {d.hero.video && (
        <video id="hero-video" class="hero-video absolute inset-0 h-full w-full object-cover object-[92%_40%] opacity-0 transition-opacity duration-1000 lg:object-[50%_80%]" autoplay muted loop playsinline preload="auto" poster={d.hero.image} aria-hidden="true">
          {d.hero.videoMobile && <source src={d.hero.videoMobile} media="(max-width: 1023px)" />}
          <source src={d.hero.video} />
        </video>
      )}
    </div>
    <div class="absolute inset-0 -z-10" style="background:radial-gradient(ellipse 68% 70% at 2% 100%, rgba(5,14,46,.94) 0%, rgba(5,14,46,.88) 25%, rgba(5,14,46,.72) 45%, rgba(5,14,46,.45) 65%, rgba(5,14,46,.17) 82%, transparent 100%)"></div>
    <div class="absolute inset-x-0 bottom-0 -z-10 h-[22%] bg-gradient-to-t from-[#050e2e]/20 to-transparent"></div>
    <div class="absolute inset-x-0 top-0 -z-10 h-[20%] bg-gradient-to-b from-[#050e2e]/30 to-transparent"></div>
    <div id="hero-shade" class="absolute inset-0 -z-10 bg-[#050b1f] opacity-0"></div>
    <div id="hero-scrim" aria-hidden="true" class="pointer-events-none absolute inset-0 -z-10 hidden lg:block" style="background:radial-gradient(ellipse 58% 36% at 50% 50%,rgba(5,11,31,.5) 0%,rgba(5,11,31,.32) 50%,rgba(5,11,31,.1) 80%,transparent 100%)"></div>


    <div id="hero-copy" class="mt-auto px-6 pb-[13vh] lg:px-20 lg:pb-12">
      <div id="hero-title" class="will-change-transform">
        <div id="hero-eyebrow" class="hero-in hp-step mb-4 flex items-center gap-3 lg:mb-5 lg:gap-5" style="--d:0.5s">
          <span class="hp-eline h-[3px] w-10 bg-white shadow-[0_1px_6px_rgba(0,0,0,0.35)] lg:w-16"></span>
          <span class="hp-etext font-display whitespace-nowrap text-[9px] font-medium uppercase tracking-[0.26em] text-white [text-shadow:0_1px_8px_rgba(0,0,0,0.45),0_0_2px_rgba(0,0,0,0.3)] sm:text-[12px] sm:tracking-[0.32em] lg:text-[13px]">{d.hero.eyebrow}</span>
        </div>
        <h1 id="hero-h1" class="w-fit max-w-[86vw] text-[clamp(1.6rem,7.2vw,3.3rem)] font-bold uppercase leading-[1.12] tracking-[0.005em] sm:max-w-[34rem] lg:max-w-[62vw] lg:text-[clamp(2.2rem,3.7vw,4.6rem)] [text-shadow:0_2px_24px_rgba(5,11,31,.7),0_0_2px_rgba(5,11,31,.35)] will-change-transform">
          {d.hero.title.split('\n').map((line, li, arr) => {
            const before = arr.slice(0, li).join(' ').split(' ').filter(Boolean).length;
            return (
              <span class="block">
                {line.split(' ').map((w, wi) => (
                  <span class="mask-word"><span class="mask-word-inner" style={`--i:${before + wi}`}>{w}</span></span>
                ))}
              </span>
            );
          })}
        </h1>
        <p id="hero-sub" class="hero-in hp-step mt-4 whitespace-pre-line max-w-[78vw] sm:max-w-[28rem] text-[13.5px] leading-relaxed text-white/90 sm:text-base lg:max-w-[48vw] lg:leading-[1.55] lg:[font-size:clamp(15px,1.15vw,19px)]" style="--d:1.6s">{subTokens.map((o) => (o.sp ? o.sp : <span class="hp-w" style={`--i:${o.i}`}>{o.w}</span>))}</p>
        <div id="hero-cta" class="hero-in hp-step mt-6 flex flex-wrap items-center gap-3 lg:absolute lg:bottom-12 lg:right-20 lg:mt-0" style="--d:1.9s">
          <a href={`https://wa.me/${d.site.phoneHref.replace('+', '')}?text=${encodeURIComponent(d.hero.waText)}`} target="_blank" rel="noopener" data-cta="hero-whatsapp" style="--i:0" class="hp-btn btn bg-white text-[#0a1748] hover:bg-white/90"><Icon name="whatsapp" size={18} /> {d.hero.ctaPrimary}</a>
          <a href="#contact" data-quote data-cta="hero-quote" style="--i:1" class="hp-btn btn hero-wa border border-white/60 bg-white/10 text-white backdrop-blur-sm hover:bg-white/20">{d.hero.ctaSecondary} <Icon name="arrow" size={18} /></a>
        </div>
      </div>
    </div>
    <script is:inline>
      (function () {
        var wrap = document.getElementById('hero-wrap'), hero = document.getElementById('hero'), bg = document.getElementById('hero-parallax'), hv = document.getElementById('hero-video');
        var scrim = document.getElementById('hero-scrim'), navEl = document.getElementById('site-nav'), copy = document.getElementById('hero-copy'), h1 = document.getElementById('hero-h1'), steps = [document.getElementById('hero-eyebrow'), document.getElementById('hero-sub'), document.getElementById('hero-cta')];
        var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches, mq = window.matchMedia('(min-width: 1024px)');
        if (hv) { hv.addEventListener('playing', function () { hv.style.opacity = '1'; }); if (reduce) hv.remove(); }
        function clamp(v) { return Math.min(1, Math.max(0, v)); }
        function ease(t) { return 1 - Math.pow(1 - t, 3); }
        var pin = false, span = 1, dx = 0, dy = 0, s0 = 1.5, tick = false;
        function setup() {
          var vh = window.innerHeight, vw = window.innerWidth;
          wrap.style.height = ''; hero.classList.remove('hp-on', 'hp-s1', 'hp-s2', 'hp-s3'); h1.style.transform = ''; h1.classList.remove('hp-ready');
          pin = !reduce && mq.matches; if (!pin) { h1.classList.add('hp-ready'); return; }
          wrap.style.height = Math.round(vh * (vw < 1024 ? 2.2 : 2.7)) + 'px'; span = Math.max(1, wrap.offsetHeight - vh);
          hero.classList.add('hp-on');
          var hr = hero.getBoundingClientRect(), r = h1.getBoundingClientRect(), rel = r.top - hr.top;
          dx = vw / 2 - (r.left + r.width / 2); dy = vh / 2 - (rel + r.height / 2);
          s0 = Math.max(1, Math.min(1.7, (vw * 0.86) / r.width));
          h1.classList.add('hp-ready'); render();
        }
        function render() {
          tick = false; var y = window.scrollY, vh = window.innerHeight;
          // as the hero leaves the screen its contents trail behind the page, so it lifts away softly
          var away = clamp((y - (pin ? span : 0)) / vh), trailBg = away * vh * 0.3, trailTx = away * vh * 0.42;
          if (pin) {
            var p = clamp(y / span), mv = ease(clamp((p - 0.04) / 0.4));
            h1.style.transform = 'translate3d(' + (dx * (1 - mv)).toFixed(1) + 'px,' + (dy * (1 - mv)).toFixed(1) + 'px,0) scale(' + (s0 + (1 - s0) * mv).toFixed(4) + ')';
            if (scrim) scrim.style.opacity = (1 - mv).toFixed(3);
            hero.classList.toggle('hp-s1', p > 0.34); hero.classList.toggle('hp-s2', p > 0.44); hero.classList.toggle('hp-s3', p > 0.58);
            bg.style.transform = 'translate3d(0,' + trailBg.toFixed(1) + 'px,0) scale(' + (1.03 + 0.1 * p).toFixed(4) + ')';
          } else if (!reduce) {
            bg.style.transform = 'translate3d(0,' + trailBg.toFixed(1) + 'px,0) scale(1.03)';
          }
          if (!reduce) copy.style.transform = 'translate3d(0,' + trailTx.toFixed(1) + 'px,0)';
          if (hv) { var off = y > wrap.offsetHeight; if (off && !hv.paused) hv.pause(); else if (!off && hv.paused && !reduce) hv.play().catch(function () {}); }
        }
        window.addEventListener('scroll', function () { if (!tick) { tick = true; requestAnimationFrame(render); } }, { passive: true });
        window.addEventListener('resize', setup); window.addEventListener('load', setup);
        setup();
      })();
    </script>
  </section>
  </div>
  <main id="main" class="relative z-10 bg-white">
    <!-- WHO WE ARE -->
    <section id="about" data-no-reveal class="py-24 lg:py-36" style={`--nt:${titleWords.length};--nw:${wIdx};--nl:${d.about.clients.length}`}>
      <div class="container-x">
        <span class="ab-tag tag"><Icon name="pin" size={18} />{d.about.tag}</span>
        <h2 class="mt-6 max-w-[16ch] font-display text-[clamp(2.4rem,5.2vw,4.6rem)] font-bold leading-[1.04] tracking-tight text-black">{titleWords.map((w, i) => <><span class="ab-mask"><span class="ab-word" style={`--i:${i}`}>{w}</span></span>{i < titleWords.length - 1 ? ' ' : ''}</>)}</h2>
        <div class="ab-line mt-12 lg:mt-14"></div>
        <div class="mt-12 grid gap-10 lg:mt-14 lg:grid-cols-[19rem_minmax(0,1fr)] lg:gap-16">
          <figure class="ab-fig group relative w-full max-w-[15rem] self-start overflow-hidden lg:max-w-none lg:self-stretch rounded-xl bg-[#0a1748]">
            <img src={d.about.person.photo} alt={d.about.person.name} loading="lazy" class="ab-fig-img aspect-[4/5] w-full object-cover lg:absolute lg:inset-0 lg:h-full lg:aspect-auto object-[50%_20%] transition-transform duration-[900ms] ease-out group-hover:scale-[1.06]" />
            <div aria-hidden="true" class="pointer-events-none absolute inset-x-0 bottom-0 h-2/5 bg-gradient-to-t from-[#050e2e]/85 via-[#050e2e]/40 to-transparent"></div>
            <figcaption class="ab-cap absolute inset-x-0 bottom-0 px-4 pb-4 text-white">
              <div class="font-display text-[15px] font-semibold leading-tight drop-shadow-[0_1px_6px_rgba(0,0,0,0.5)]">{d.about.person.name}</div>
              <div class="mt-1 text-[10px] font-medium uppercase tracking-[0.18em] text-white/85 drop-shadow-[0_1px_4px_rgba(0,0,0,0.5)]">{d.about.person.role}</div>
            </figcaption>
          </figure>
          <div>
            <p class="font-display text-[1.45rem] font-medium leading-snug text-neutral-800 lg:text-[2rem]">{aboutWords.map((o) => (o.sp ? ' ' : <span class:list={['ab-w', o.hl && 'ab-hl']} style={`--i:${o.i}`}>{o.w}</span>))}</p>
            <div class="ab-x mt-12 lg:mt-14" style="--xd:.7s">
              <div class="font-display text-[11px] font-semibold uppercase tracking-[0.2em] text-neutral-500">{d.about.clientsTitle}</div>
              <ul class="mt-4 flex flex-wrap items-center gap-x-10 gap-y-5">
                {d.about.clients.map((c) => (
                  <li class="ab-logo flex h-12 items-center" style={`--i:${d.about.clients.indexOf(c)}`}>
                    {c.logo ? <img src={c.logo} alt={c.name} loading="lazy" class="max-h-11 w-auto max-w-[8.5rem] object-contain" /> : <span class="font-display text-xl font-bold uppercase tracking-wide text-neutral-800">{c.name}</span>}
                  </li>
                ))}
                <li class="ab-logo font-display text-[13px] font-semibold uppercase tracking-[0.2em] text-neutral-400" style={`--i:${d.about.clients.length}`}>{d.about.clientsMore}</li>
              </ul>
              {d.site.profileUrl && <div class="mt-5 text-sm"><a href={d.site.profileUrl} download class="inline-flex items-center gap-1.5 font-display font-semibold text-brand underline-offset-4 hover:underline">{d.site.profileLabel} <Icon name="arrowUpRight" size={15} /></a></div>}
            </div>
            <a href={d.about.ctaHref} class="ab-x btn btn-brand group/btn mt-8" style="--xd:1s">{d.about.cta} <span class="transition-transform duration-300 group-hover/btn:translate-x-1"><Icon name="arrow" size={18} /></span></a>
          </div>
        </div>
        <div class="ab-x mt-20 lg:mt-28" data-late style="--xd:0s">
          <div class="grid grid-cols-2 border-y border-neutral-300 lg:grid-cols-4">
            {d.stats.map((st, i) => (
              <div data-stat class:list={['px-1 py-7 lg:px-8 lg:py-10', i % 2 === 1 && 'border-l border-neutral-300 pl-6', i > 1 && 'max-lg:border-t border-neutral-300', i > 0 && 'lg:border-l lg:border-neutral-300', i === 0 && 'lg:pl-0', i === 2 && 'max-lg:border-l-0 max-lg:pl-1']}>
                <div class="font-display text-[clamp(2.6rem,5vw,4.8rem)] font-medium leading-none tracking-tight text-neutral-950">{st.count ? <><span aria-hidden="true"><span data-count={st.value}>{Number(st.value).toLocaleString('en-US')}</span>{st.suffix}</span><span class="sr-only">{Number(st.value).toLocaleString('en-US')}{st.suffix}</span></> : st.value}</div>
                <div class="mt-3.5 max-w-[14rem] font-display text-sm leading-snug text-neutral-600 lg:text-[15px]">{st.label}</div>
              </div>
            ))}
          </div>
        </div>
      </div>
      <script is:inline>
        (function () {
          var s = document.getElementById('about');
          if (!s || matchMedia('(prefers-reduced-motion: reduce)').matches) return;
          s.classList.add('ab-js');
          // Plays in once, forward only, when the section scrolls into view.
          var io = new IntersectionObserver(function (es) {
            var e = es[es.length - 1];
            if (e.isIntersecting) { s.classList.add('ab-in'); io.disconnect(); }
          }, { threshold: [0, 0.05], rootMargin: '0px 0px -6% 0px' });
          // lower blocks (stats) wait until they are actually on screen, so nobody scrolls past them unseen
          var lio = new IntersectionObserver(function (es) { es.forEach(function (e) { if (e.isIntersecting) { e.target.classList.add('is-in'); lio.unobserve(e.target); } }); }, { threshold: 0.2, rootMargin: '0px 0px -8% 0px' });
          [].forEach.call(s.querySelectorAll('[data-late]'), function (el) { lio.observe(el); });
          if (innerWidth >= 1024) io.observe(s);
          else {
            // phones: every block plays as it reaches the screen, not all at once when the section starts
            var sio = new IntersectionObserver(function (es) {
              es.forEach(function (e) {
                if (!e.isIntersecting) return;
                var t = e.target, fg = t.__fig;
                if (fg) { fg.classList.add('ab-self'); [].forEach.call(fg.querySelectorAll('.ab-fig-img, .ab-cap'), function (d) { d.classList.add('ab-self'); }); sio.unobserve(t); return; }
                t.classList.add('ab-self');
                [].forEach.call(t.querySelectorAll('.ab-fig-img, .ab-cap, .ab-w, .ab-logo, .ab-x'), function (d) { d.classList.add('ab-self'); });
                sio.unobserve(t);
              });
            }, { threshold: 0.2, rootMargin: '0px 0px -8% 0px' });
            [].forEach.call(s.querySelectorAll('.ab-tag, .ab-line, .ab-x'), function (el) { sio.observe(el); });
            // the photo starts fully clipped, which hides it from the observer, so watch its wrapper instead
            var fgr = s.querySelector('.ab-fig'); if (fgr && fgr.parentElement) { fgr.parentElement.__fig = fgr; sio.observe(fgr.parentElement); }
            var pw = s.querySelector('.ab-w'); if (pw && pw.parentElement) sio.observe(pw.parentElement);
          }
          // Headline: words darken one by one as you scroll (bluesqx-style scrub), both directions.
          var ws = s.querySelectorAll('.ab-word'), h2 = s.querySelector('h2');
          if (ws.length && h2) {
            var tk = false;
            var paint = function () {
              tk = false;
              var r = h2.getBoundingClientRect(), vh = innerHeight;
              var p = Math.min(1, Math.max(0, (vh * 0.88 - r.top) / (vh * 0.5)));
              for (var i = 0; i < ws.length; i++) {
                var q = Math.min(1, Math.max(0, p * (ws.length + 1) - i - 0.2));
                var c = Math.round(208 - q * 208);
                ws[i].style.color = 'rgb(' + c + ',' + c + ',' + Math.round(c + q * 0) + ')';
              }
            };
            addEventListener('scroll', function () { if (!tk) { tk = true; requestAnimationFrame(paint); } }, { passive: true });
            addEventListener('resize', paint); paint();
          }
        })();
      </script>
    </section>

    <!-- BRAND SIGNATURE -->
    <div class="overflow-hidden border-b border-white/10 bg-[#0d0f14] py-3 text-white" aria-hidden="true">
      <div class="marquee-track">
        {[...marquee, ...marquee].map((m, i) => (
          <span class="flex items-center gap-6 px-6 font-display text-4xl font-semibold uppercase lg:text-5xl">
            <span class:list={[i % 2 === 0 ? 'outline-text' : '']}>{m}</span>
            <span class="text-white/40">.</span>
          </span>
        ))}
      </div>
    </div>

    <!-- WHAT WE DO -->
    <section id="services" data-reveal class="bg-[#0d0f14] py-24 text-white lg:py-36">
      <div class="container-x">
        <div class="grid items-end gap-8 lg:grid-cols-2">
          <div><span class="tag" style="background:transparent;color:#fff;border-color:rgba(255,255,255,.28)"><Icon name="truck" size={18} />{d.services.tag}</span><h2 class="h2 mt-5 max-w-[34rem] !text-white">{d.services.title}</h2></div>
          <div class="lg:text-right"><p class="ml-auto max-w-xl !text-white/75">{d.services.text}</p><a href="/what-we-do" class="btn mt-6 bg-white text-black hover:bg-white/90">{d.services.cta} <Icon name="arrow" size={18} /></a></div>
        </div>
        <div id="svc-row" class="svc-row mt-14 lg:mt-20">
          {d.services.items.map((s, i) => (
            <article class:list={['svc-card rounded-xl', i === 0 && 'is-active']} tabindex="0">
              <img src={s.image} alt="" loading="lazy" class="svc-img" style={`object-position:${s.pos}`} />
              <div class="svc-glow" aria-hidden="true"></div>
              <div class="absolute inset-x-0 top-0 flex items-start justify-between p-5">
                <div class="flex items-center gap-2">
                  <span class="font-display text-sm font-semibold tracking-widest text-white/90">0{i + 1}</span>
                  {s.flagship && <span class="svc-flag rounded border border-white/40 px-2 py-0.5 font-display text-[10px] font-semibold uppercase tracking-widest text-white">Flagship</span>}
                </div>
                <span class="grid h-11 w-11 place-items-center rounded-md border border-white/30 bg-white/15 text-white"><Icon name={s.icon} size={22} /></span>
              </div>
              <div class="svc-body">
                <h3 class="font-display text-xl font-semibold leading-snug drop-shadow-[0_2px_10px_rgba(0,0,0,0.55)] lg:text-[1.55rem]">{s.title}</h3>
                <div class="svc-more"><div class="flex items-end justify-between gap-4">
                  <p class="mt-2 max-w-sm text-sm text-white/90 drop-shadow-[0_1px_6px_rgba(0,0,0,0.55)]">{s.text}</p>
                  <a href="/what-we-do" aria-label={s.title} class="svc-arrow shrink-0"><Icon name="arrowUpRight" size={20} /></a>
                </div></div>
              </div>
            </article>
          ))}
        </div>
      </div>
      <script is:inline>
        (function () {
          var row = document.getElementById('svc-row'); if (!row) return;
          var cards = [].slice.call(row.querySelectorAll('.svc-card'));
          // Entrance (bluesqx-style): cards slide in from the right one by one, scrubbed by scroll.
          if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
            var R = [-3, 3, -3, 3], tk = false;
            row.parentElement.style.overflowX = 'clip';
            cards.forEach(function (c) { c.style.willChange = 'transform'; });
            var cur = -1, tgt = 0, run = false;
            var apply = function (p) {
              var vw = innerWidth;
              cards.forEach(function (c, i) {
                var q = Math.min(1, Math.max(0, (p - i * 0.17) / 0.49));
                var e = -(Math.cos(Math.PI * q) - 1) / 2; e = e * (2 - e) * 0.6 + e * 0.4; var k = 1 - e;
                var left = row.getBoundingClientRect().left + (c.offsetParent === row ? c.offsetLeft : c.offsetLeft - row.offsetLeft);
                c.style.transform = q >= 1 ? '' : 'translate3d(' + ((vw - left + 40) * k).toFixed(1) + 'px,0,0) rotate(' + (R[i % 4] * k).toFixed(2) + 'deg)';
              });
            };
            var frame = function () {
              cur += (tgt - cur) * 0.06;
              if (Math.abs(tgt - cur) < 0.0008) cur = tgt;
              apply(cur);
              if (cur !== tgt) requestAnimationFrame(frame); else run = false;
            };
            var tilt = function () {
              tk = false;
              var top = row.getBoundingClientRect().top, vh = innerHeight;
              tgt = Math.min(1, Math.max(0, (vh * 0.92 - top) / (vh * 0.5)));
              if (cur < 0) cur = tgt;
              if (!run) { run = true; requestAnimationFrame(frame); }
            };
            var tick0 = function () { if (!tk) { tk = true; requestAnimationFrame(tilt); } };
            addEventListener('scroll', tick0, { passive: true });
            addEventListener('resize', tilt); tilt();
          }
          // Photos are sized to the expanded width once, so the card just reveals more of a still image (no zoom).
          function sizeImgs() {
            if (innerWidth < 1024) { row.style.removeProperty('--ew'); return; }
            var g = parseFloat(getComputedStyle(row).columnGap) || 14;
            row.style.setProperty('--ew', Math.ceil((row.clientWidth - 3 * g) * 2.9 / 5.9) + 'px');
          }
          sizeImgs(); addEventListener('resize', sizeImgs);
          function set(c) { cards.forEach(function (x) { x.classList.toggle('is-active', x === c); }); }
          cards.forEach(function (c) {
            var ht; c.addEventListener('mouseenter', function () { clearTimeout(ht); ht = setTimeout(function () { if (c.matches(':hover')) set(c); }, 140); });
            c.addEventListener('mouseleave', function () { clearTimeout(ht); });
            c.addEventListener('focus', function () { set(c); });
            c.addEventListener('click', function () { set(c); });
            c.addEventListener('pointermove', function (e) {
              var r = c.getBoundingClientRect();
              c.style.setProperty('--mx', (e.clientX - r.left) + 'px');
              c.style.setProperty('--my', (e.clientY - r.top) + 'px');
            });
          });
        })();
      </script>
    </section>

    <!-- FLEET & NETWORK -->
    <section id="fleet" data-reveal class="bg-[#eceff3] py-24 lg:py-36">
      <div class="container-x">
        <span class="flex items-center gap-3 font-display text-[12px] font-semibold uppercase tracking-[0.2em] text-neutral-700"><span class="h-2 w-2 bg-brand"></span>{d.fleet.tag}</span>
        <div class="mt-6 grid items-end gap-6 lg:grid-cols-2 lg:gap-16">
          <h2 class="max-w-[12ch] font-display text-[clamp(2.2rem,4.6vw,4.2rem)] font-medium leading-[1.02] tracking-tight text-neutral-950">{d.fleet.title}</h2>
          <div class="max-w-md lg:pb-2">
            <p class="text-[15px] leading-relaxed text-neutral-600">{d.fleet.text}</p>
            <a href="/fleet" class="btn btn-brand group/btn mt-6">{d.fleet.moreCta} <span class="transition-transform duration-300 group-hover/btn:translate-x-1"><Icon name="arrow" size={18} /></span></a>
          </div>
        </div>
        <div class="mt-14 grid grid-cols-2 gap-3 sm:grid-cols-3 lg:mt-20 lg:grid-cols-4 lg:gap-4">
          {fleetAll.map((v) => (
            <a href={`/fleet#${v.id}`} class="gl-tile group relative flex flex-col rounded-xl bg-[#f0f3f9] p-4 transition-all duration-500 hover:-translate-y-1 hover:bg-[#e6ebf7] lg:p-5">
              <span class="font-display text-[10px] font-semibold uppercase tracking-[0.18em] text-neutral-500">{v.group}</span>
              <span class="my-2 block h-[7rem] lg:h-[8.5rem]"><img src={v.image} alt="" loading="lazy" class="h-full w-full object-contain transition-transform duration-500 group-hover:scale-[1.06]" /></span>
              <span class="mt-1 flex items-center justify-between gap-2 font-display text-[1rem] font-medium leading-tight text-neutral-950 lg:text-[1.1rem]">{v.name}<span class="shrink-0 text-brand opacity-0 transition duration-300 group-hover:opacity-100"><Icon name="arrowUpRight" size={18} /></span></span>
            </a>
          ))}
          <a href="/fleet#helper" class="gl-tile group flex flex-col justify-between rounded-xl bg-neutral-950 p-5 text-white transition-all duration-500 hover:-translate-y-1 hover:bg-brand">
            <span class="grid h-12 w-12 place-items-center rounded-lg border border-white/30"><Icon name="target" size={22} /></span>
            <span>
              <span class="mt-8 block font-display text-[1.25rem] font-medium leading-tight">{fleetData.glance.help}</span>
              <span class="mt-2 block text-[13px] leading-snug text-white/70">{fleetData.glance.helpText}</span>
            </span>
          </a>
        </div>
      </div>
    </section>

    <!-- COVERAGE -->
    <section id="coverage" data-reveal class="relative isolate overflow-hidden bg-[#0b0d12] py-24 text-white lg:py-36">
      <svg aria-hidden="true" viewBox={map.viewBox} class="pointer-events-none absolute -right-[8%] top-1/2 -z-10 hidden h-[112%] w-auto max-w-none -translate-y-1/2 lg:block" preserveAspectRatio="xMidYMid meet">
        <g fill="#ffffff" opacity=".05">{map.states.map((st) => <path d={st.d} />)}</g>
      </svg>
      <div class="container-x">
        <span class="flex items-center gap-3 font-display text-[12px] font-semibold uppercase tracking-[0.2em] text-white/70"><span class="h-2 w-2 bg-white"></span>{d.coverage.tag}</span>
        <div class="mt-6 grid items-end gap-6 lg:grid-cols-2 lg:gap-16">
          <h2 class="max-w-[12ch] font-display text-[clamp(2.4rem,5.2vw,4.8rem)] font-medium leading-[1.02] tracking-tight">{d.coverage.title}</h2>
          <div class="max-w-md lg:pb-2">
            <p class="text-[15px] leading-relaxed text-white/60">{d.coverage.text}</p>
            <a href="#contact" data-quote data-cta="coverage-quote" class="btn group/btn mt-6 bg-white text-neutral-950 hover:bg-neutral-200">{d.coverage.cta} <span class="transition-transform duration-300 group-hover/btn:translate-x-1"><Icon name="arrow" size={18} /></span></a>
          </div>
        </div>

        <div class="mt-20 border-t border-white/15 pt-10 lg:mt-28 lg:pt-14">
          <p class="font-display text-[11px] font-semibold uppercase tracking-[0.22em] text-white/50">{d.coverage.bigIntro}</p>
          <div class="mt-5 flex flex-wrap items-baseline gap-x-4 font-display font-medium leading-none tracking-tight">
            <span aria-hidden="true" class="text-[clamp(3rem,10.5vw,9.6rem)]"><span data-count={d.coverage.bigNumber}>{Number(d.coverage.bigNumber).toLocaleString('en-US')}</span>{d.coverage.bigSuffix}</span>
            <span aria-hidden="true" class="text-[clamp(1.4rem,3vw,2.6rem)] text-white/50">{d.coverage.bigUnit}</span>
            <span class="sr-only">{Number(d.coverage.bigNumber).toLocaleString('en-US')}{d.coverage.bigSuffix} {d.coverage.bigUnit}</span>
          </div>
          <div class="mt-6 grid gap-3 lg:grid-cols-2 lg:gap-16">
            <p class="font-display text-xl font-medium lg:text-2xl">{d.coverage.bigLabel}</p>
            <p class="max-w-md text-[13px] leading-relaxed text-white/40">{d.coverage.bigNote}</p>
          </div>
        </div>

        <div class="mt-20 lg:mt-28">
          <span class="flex items-center gap-3 font-display text-[11px] font-semibold uppercase tracking-[0.22em] text-white/50"><span class="h-px w-8 bg-white/40"></span>{d.coverage.regionsLabel}</span>
          <p class="mt-7 max-w-[72rem] font-display text-[clamp(1.6rem,3.2vw,2.9rem)] font-medium leading-[1.3] tracking-tight">
            {allRegions.map((r, i) => (<><span class="cov-r whitespace-nowrap text-white/90 transition-colors duration-300 hover:text-white">{r}</span>{i < allRegions.length - 1 && <><span class="ml-[0.3em] text-white/25">/</span>{' '}</>}</>))}
          </p>
          <div class="mt-9 flex flex-wrap items-baseline gap-x-6 gap-y-2 border-t border-white/15 pt-6">
            <span class="font-display text-[11px] font-semibold uppercase tracking-[0.22em] text-white/45">{d.coverage.crossTag}</span>
            <p class="font-display text-[clamp(1.2rem,2vw,1.6rem)] font-medium tracking-tight text-white/70">
              {crossBorder.map((r, i) => (<><span>{r}</span>{i < crossBorder.length - 1 && <><span class="ml-[0.3em] text-white/25">/</span>{' '}</>}</>))}
            </p>
          </div>
        </div>

        <div class="mt-8 flex flex-wrap items-center justify-between gap-x-10 gap-y-2 text-[13px] text-white/50">
          <p>{d.coverage.hqNote}</p>
        </div>
        <p class="mt-6 text-[11px] text-white/25">{d.coverage.credit}</p>
      </div>
    </section>

    <!-- TRACK RECORD -->
    <section id="record" data-reveal class="overflow-hidden py-24 lg:py-36">
      <div class="container-x">
        <div class="grid items-end gap-6 lg:grid-cols-[1.3fr_1fr] lg:gap-16">
          <div>
            <span class="tag"><Icon name="flow" size={18} />{d.record.tag}</span>
            <h2 class="h2 mt-5 lg:text-[clamp(2.2rem,4vw,3.4rem)]">{d.record.title}</h2>
            <p class="mt-4 max-w-xl text-neutral-600">{d.record.text}</p>
          </div>
        </div>
      </div>

      <div class="container-x mt-16 flex items-center gap-4 text-[11px] font-semibold uppercase tracking-[0.2em] text-neutral-500 lg:mt-20">
        <span class="shrink-0">{d.record.listTitle}</span>
        <span class="h-px flex-1 bg-neutral-200"></span>
        <span class="hidden shrink-0 sm:block">{d.record.moreText}</span>
      </div>
      <div class="poster-wall client-fade mt-6 overflow-x-auto overflow-y-hidden" aria-label={d.record.listTitle} tabindex="0" role="region">
        <div class="flex w-max items-center">
          {[0, 1].map((c) => posters.map((e) => (
            <figure class="group relative mx-2 shrink-0 overflow-hidden rounded-lg border border-neutral-200 bg-soft" aria-hidden={c > 0 ? 'true' : undefined}>
              <img src={e.image} width={e.w} height={e.h} alt={c === 0 ? `${e.name}${e.year ? ' ' + e.year : ''}` : ''} loading="eager" decoding="async" fetchpriority="low" class="block h-64 w-auto max-w-none transition-transform duration-700 group-hover:scale-[1.03] lg:h-72" />
              {e.year && <span class="absolute left-2.5 top-2.5 rounded-sm bg-black/60 px-2.5 py-1 font-display text-[10px] font-semibold tracking-wider text-white">{e.year}</span>}
            </figure>
          )))}
        </div>
      </div>
      <script is:inline>
        (function () {
          // Posters drift on their own; touch swipe or mouse drag takes over, then the drift resumes
          var w = document.querySelector('.poster-wall'); if (!w) return;
          var tr = w.firstElementChild, reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
          var pos = 0, last = performance.now(), hold = 0, visible = false, hover = false, drag = null;
          var half = function () { return tr.scrollWidth / 2; };
          var touch = function () { hold = performance.now() + 2600; pos = w.scrollLeft; };
          w.addEventListener('touchstart', touch, { passive: true });
          w.addEventListener('touchmove', touch, { passive: true });
          w.addEventListener('wheel', touch, { passive: true });
          w.addEventListener('pointerdown', function (e) { if (e.pointerType !== 'mouse') return; drag = { x: e.clientX, l: w.scrollLeft }; w.classList.add('is-drag'); w.setPointerCapture(e.pointerId); });
          w.addEventListener('pointermove', function (e) { if (!drag) return; w.scrollLeft = drag.l - (e.clientX - drag.x); pos = w.scrollLeft; hold = performance.now() + 2600; });
          var end = function () { if (!drag) return; drag = null; w.classList.remove('is-drag'); };
          w.addEventListener('pointerup', end); w.addEventListener('pointercancel', end);
          w.addEventListener('mouseenter', function () { hover = true; }); w.addEventListener('mouseleave', function () { hover = false; });
          w.addEventListener('keydown', function (e) { if (e.key === 'ArrowRight') { w.scrollLeft += 260; touch(); } else if (e.key === 'ArrowLeft') { w.scrollLeft -= 260; touch(); } });
          new IntersectionObserver(function (es) { visible = es[0].isIntersecting; }, { threshold: 0.05 }).observe(w);
          function loop(t) {
            var dt = Math.min((t - last) / 1000, 0.05); last = t;
            var h = half();
            if (h > 0) {
              if (!reduce && visible && !hover && !drag && t > hold) { pos += 42 * dt; w.scrollLeft = pos; } else if (t <= hold || drag || hover) { pos = w.scrollLeft; }
              if (w.scrollLeft >= h) { w.scrollLeft -= h; pos = w.scrollLeft; } else if (w.scrollLeft <= 0 && (drag || t <= hold)) { w.scrollLeft = h - 1; pos = w.scrollLeft; }
            }
            requestAnimationFrame(loop);
          }
          requestAnimationFrame(loop);
        })();
      </script>
      <div class="container-x mt-16 flex flex-col items-start justify-between gap-4 border-t border-neutral-300 pt-8 sm:flex-row sm:items-center lg:mt-20">
        <p class="font-display text-lg font-medium tracking-tight text-neutral-950">Looking to drive with us?</p>
        <a href="/join-our-network#drivers" class="btn btn-brand group/btn w-fit">Apply as a driver <span class="transition-transform duration-300 group-hover/btn:translate-x-1"><Icon name="arrow" size={18} /></span></a>
      </div>
    </section>
  </main>

  <SiteClosing home />
  <QuoteDialog />
</Base>
